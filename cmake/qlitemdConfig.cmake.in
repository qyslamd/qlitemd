@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)

set(_qlitemd_libdir "${PACKAGE_PREFIX_DIR}/lib")

find_library(QLITEMD_MDHTML_LIBRARY
    NAMES qlitemd_mdhtml
    PATHS "${_qlitemd_libdir}"
    NO_DEFAULT_PATH
    REQUIRED)
find_library(QLITEMD_MD4C_LIBRARY
    NAMES md4c
    PATHS "${_qlitemd_libdir}"
    NO_DEFAULT_PATH
    REQUIRED)
find_library(QLITEMD_TREE_SITTER_CORE_LIBRARY
    NAMES tree_sitter_core
    PATHS "${_qlitemd_libdir}"
    NO_DEFAULT_PATH
    REQUIRED)
find_library(QLITEMD_TREE_SITTER_GRAMMARS_LIBRARY
    NAMES tree_sitter_grammars
    PATHS "${_qlitemd_libdir}"
    NO_DEFAULT_PATH
    REQUIRED)
if("@QLITEMD_NEEDS_QUICKJS@" STREQUAL "TRUE")
    find_library(QLITEMD_QJS_LIBRARY
        NAMES qjs
        PATHS "${_qlitemd_libdir}"
        NO_DEFAULT_PATH
        REQUIRED)
endif()

# Native SVG backends are optional shared libraries. The core itself only
# produces SVG, so resvg (a rasterizer) is never part of the SDK.
set(_qlitemd_native_libraries "")
if(WIN32)
    if("@QLITEMD_FORMULA_BACKEND@" STREQUAL "ratex")
        if(NOT TARGET qlitemd::ratex)
            add_library(qlitemd::ratex SHARED IMPORTED)
            set_target_properties(qlitemd::ratex PROPERTIES
                IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/bin/ratex_ffi.dll"
                IMPORTED_IMPLIB "${_qlitemd_libdir}/ratex_ffi.dll.lib")
        endif()
        list(APPEND _qlitemd_native_libraries qlitemd::ratex)
    endif()
    if("@QLITEMD_MERMAID_BACKEND@" STREQUAL "merman")
        if(NOT TARGET qlitemd::merman)
            add_library(qlitemd::merman SHARED IMPORTED)
            set_target_properties(qlitemd::merman PROPERTIES
                IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/bin/merman_ffi.dll"
                IMPORTED_IMPLIB "${_qlitemd_libdir}/merman_ffi.dll.lib")
        endif()
        list(APPEND _qlitemd_native_libraries qlitemd::merman)
    endif()
else()
    if("@QLITEMD_FORMULA_BACKEND@" STREQUAL "ratex")
        find_library(QLITEMD_RATEX_LIBRARY
            NAMES ratex_ffi
            PATHS "${_qlitemd_libdir}"
            NO_DEFAULT_PATH
            REQUIRED)
        list(APPEND _qlitemd_native_libraries ${QLITEMD_RATEX_LIBRARY})
    endif()
    if("@QLITEMD_MERMAID_BACKEND@" STREQUAL "merman")
        find_library(QLITEMD_MERMAN_LIBRARY
            NAMES merman_ffi
            PATHS "${_qlitemd_libdir}"
            NO_DEFAULT_PATH
            REQUIRED)
        list(APPEND _qlitemd_native_libraries ${QLITEMD_MERMAN_LIBRARY})
    endif()
endif()

# Static archives first; their dependencies follow.
set(_qlitemd_link_libraries
    ${QLITEMD_MD4C_LIBRARY}
    ${QLITEMD_TREE_SITTER_GRAMMARS_LIBRARY}
    ${QLITEMD_TREE_SITTER_CORE_LIBRARY}
    ${_qlitemd_native_libraries})
if("@QLITEMD_NEEDS_QUICKJS@" STREQUAL "TRUE")
    list(APPEND _qlitemd_link_libraries ${QLITEMD_QJS_LIBRARY})
endif()
list(APPEND _qlitemd_link_libraries Threads::Threads ${CMAKE_DL_LIBS})
if(UNIX AND NOT APPLE)
    list(APPEND _qlitemd_link_libraries m)
endif()

if(MSVC)
    set(_qlitemd_compile_options "/utf-8")
else()
    set(_qlitemd_compile_options "")
endif()

if(NOT TARGET qlitemd::mdhtml)
    add_library(qlitemd::mdhtml STATIC IMPORTED)
    set_target_properties(qlitemd::mdhtml PROPERTIES
        IMPORTED_LOCATION "${QLITEMD_MDHTML_LIBRARY}"
        IMPORTED_LINK_INTERFACE_LANGUAGES "CXX;C"
        INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/include/qlitemd"
        INTERFACE_COMPILE_FEATURES "cxx_std_17"
        INTERFACE_COMPILE_OPTIONS "${_qlitemd_compile_options}"
        INTERFACE_LINK_LIBRARIES "${_qlitemd_link_libraries}")
endif()
