Use Interlocked for the SAB refcount under MSVC 2019

MSVC 2019 has no C11 atomics and therefore no <stdatomic.h>. qjsc/qjs CLI
link qjs-libc, which includes quickjs-c-atomics.h unconditionally when
JS_HAVE_THREADS is on. Map the single 32-bit fetch-add to the MSVC
intrinsic so qjs-libc (and thus qjsc/qjs) can be built with VS2019.

diff --git a/quickjs-libc.c b/quickjs-libc.c
index fc2cd18..693209a 100644
--- a/quickjs-libc.c
+++ b/quickjs-libc.c
@@ -90,7 +90,13 @@ extern char **environ;
 #include "quickjs-libc.h"
 
 #if JS_HAVE_THREADS
+#if defined(_MSC_VER) && !defined(__clang__)
+/* MSVC 2019 lacks C11 atomics/stdatomic.h; the SAB refcount only needs a
+   32-bit atomic add, so use the intrinsic instead. */
+#include <intrin.h>
+#else
 #include "quickjs-c-atomics.h"
+#endif
 #define USE_WORKER // enable os.Worker
 #endif
 
@@ -3958,7 +3964,11 @@ static JSContext *(*js_worker_new_context_func)(JSRuntime *rt);
 
 static int atomic_add_int(int *ptr, int v)
 {
+#if defined(_MSC_VER) && !defined(__clang__)
+    return (int)_InterlockedExchangeAdd((volatile long *)ptr, (long)v) + v;
+#else
     return atomic_fetch_add((_Atomic uint32_t*)ptr, v) + v;
+#endif
 }
 
 /* shared array buffer allocator */
