 const int kScrollBarStep = 40;
 
+namespace {
+
+// Layout depends on the viewport height when the document uses percentage
+// heights, percentage top/bottom offsets, CSS variables holding either, or
+// fixed positioning. Strip code samples first: documentation often shows these
+// declarations as text and must not disable the fast path.
+bool ScanViewportDependent(const QString &html)
+{
+    static const QRegularExpression kPre(
+        QStringLiteral("<pre\\b[^>]*>.*?</pre>"),
+        QRegularExpression::CaseInsensitiveOption
+            | QRegularExpression::DotMatchesEverythingOption);
+    static const QRegularExpression kLineNumberCode(
+        QStringLiteral("<table\\b[^>]*class=\"md-code\"[^>]*>.*?</table>"),
+        QRegularExpression::CaseInsensitiveOption
+            | QRegularExpression::DotMatchesEverythingOption);
+    static const QRegularExpression kInlineCode(
+        QStringLiteral("<code\\b[^>]*>.*?</code>"),
+        QRegularExpression::CaseInsensitiveOption
+            | QRegularExpression::DotMatchesEverythingOption);
+    static const QRegularExpression kCssComment(
+        QStringLiteral("/\\*.*?\\*/"),
+        QRegularExpression::DotMatchesEverythingOption);
+    static const QRegularExpression kHtmlComment(
+        QStringLiteral("<!--.*?-->"),
+        QRegularExpression::DotMatchesEverythingOption);
+    static const QRegularExpression kHeightPercentage(
+        QStringLiteral("(?<![\\w-])(?:min-|max-)?height\\s*[:=]\\s*[\"']?\\s*[0-9.]+%"),
+        QRegularExpression::CaseInsensitiveOption);
+    static const QRegularExpression kTopBottomPercentage(
+        QStringLiteral("(?<![\\w-])(?:top|bottom)\\s*:\\s*[+-]?[0-9.]+%"),
+        QRegularExpression::CaseInsensitiveOption);
+    static const QRegularExpression kVar(
+        QStringLiteral("var\\s*\\("),
+        QRegularExpression::CaseInsensitiveOption);
+    static const QRegularExpression kFixed(
+        QStringLiteral("position\\s*:\\s*fixed"),
+        QRegularExpression::CaseInsensitiveOption);
+
+    QString text = html;
+    text.remove(kPre);
+    text.remove(kLineNumberCode);
+    text.remove(kInlineCode);
+    text.remove(kCssComment);
+    text.remove(kHtmlComment);
+    return text.contains(kHeightPercentage)
+        || text.contains(kTopBottomPercentage)
+        || text.contains(kVar)
+        || text.contains(kFixed);
+}
+
+} // namespace
+
