# Embeds the bundled tree-sitter highlight queries into the Qt-free core.
#
# Usage:
#   cmake -DQL_TS_LANG_ROOT=<3rdparty/tree-sitter-lang>
#         -DQL_OUTPUT=<generated .cpp>
#         -P cmake/embed_mdhtml_queries.cmake
#
# The queries are shipped as text on purpose (not as compiled resources):
# the core must not depend on Qt's resource system. Raw string literals keep
# the source bytes untouched; the delimiter is checked to keep that true.

if(NOT DEFINED QL_TS_LANG_ROOT OR NOT DEFINED QL_OUTPUT)
  message(FATAL_ERROR "QL_TS_LANG_ROOT and QL_OUTPUT are required")
endif()

set(languages
    bash
    batch
    c
    cpp
    css
    go
    html
    java
    javascript
    json
    python
    rust
)

set(body "")
foreach(language IN LISTS languages)
  set(query_file "${QL_TS_LANG_ROOT}/${language}/queries/highlights.scm")
  if(NOT EXISTS "${query_file}")
    message(FATAL_ERROR "missing highlight query: ${query_file}")
  endif()
  file(READ "${query_file}" content)
  if(content MATCHES "QLITEMD_SCM")
    message(FATAL_ERROR "raw string delimiter conflict in ${query_file}")
  endif()
  string(APPEND body
      "  {\"${language}\",\n   R\"QLITEMD_SCM(${content})QLITEMD_SCM\"},\n")
endforeach()

file(WRITE "${QL_OUTPUT}"
"// Generated by cmake/embed_mdhtml_queries.cmake. Do not edit.
#include <string_view>

#include \"md_queries.h\"

namespace {

struct EmbeddedQuery {
  const char* name;
  const char* text;
};

const EmbeddedQuery kQueries[] = {
${body}};

}  // namespace

std::string_view MdEmbeddedHighlightQuery(std::string_view name) {
  for (const EmbeddedQuery& query : kQueries) {
    if (name == query.name) {
      return query.text;
    }
  }
  return {};
}
")
