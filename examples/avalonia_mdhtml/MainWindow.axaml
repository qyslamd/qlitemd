<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AvaloniaMdhtml.MainWindow"
        Title="qlitemd mdhtml — Avalonia validation"
        Width="1120" Height="860"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Padding="12,10" Background="Transparent">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="LightButton" Content="Light" />
        <Button x:Name="DarkButton" Content="Dark" />
        <Button x:Name="RenderButton" Content="Re-render" />
        <TextBlock x:Name="StatusText" Margin="12,0,0,0"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Border>
    <ScrollViewer x:Name="HtmlScrollViewer" Grid.Row="1"
                  Margin="12"
                  HorizontalContentAlignment="Left"
                  VerticalContentAlignment="Top" />
    <TextBlock x:Name="FooterText" Grid.Row="2" Margin="12,0,12,8"
               Opacity="0.7" FontSize="12" />
  </Grid>
</Window>
